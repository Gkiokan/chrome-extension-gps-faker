{
  "all": {
    "manifest_version": 3,

    "icons": {
      "16": "icons/icon-16x16.png",
      "48": "icons/icon-48x48.png",
      "128": "icons/icon-128x128.png"
    },

    "permissions": [
      "storage",
      "geolocation",
      "sidePanel",
      "activeTab",
      "scripting",
      "tabs"
    ],

    "host_permissions": [ "*://*/*" ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'self';"
    },
    "web_accessible_resources": [
      {
        "resources": [ "*" ],
        "matches": [ "*://*/*" ]
      }
    ],

    "action": {
      "_default_popup": "www/index.html",
      "default_title": "GPS Faker v2"
    },
    "side_panel": {
      "default_path": "www/index.html"
    },    
    "options_ui": {
      "page": "www/index.html",
      "open_in_tab": false
    },

    "content_scripts": [
      {
        "matches": [ "<all_urls>" ],
        "css": [ "assets/content.css" ],
        "js": [           
          "inject.js"
        ],
        "run_at": "document_start",
        "world": "MAIN"
      },
      {
        "matches": [ "<all_urls>" ],
        "js": [
          "inject-hook.js"
        ],
        "run_at": "document_start",
        "_": [
          "my-content-script.js",
          "content-hooks.js"
        ]
      }      
    ]
  },

  "chrome": {
    "background": {
      "service_worker": "background.js"
    }
  },

  "firefox": {
    "background": {
      "scripts": [ "background.js" ]
    }
  },
  "permissions": ["sidePanel"]
}
