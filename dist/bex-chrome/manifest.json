{
  "manifest_version": 3,
  "name": "GPS Faker v2",
  "short_name": "GPS Faker v2",
  "icons": {
    "16": "icons/favicon-16x16.png",
    "32": "icons/favicon-32x32.png",
    "96": "icons/favicon-96x96.png",
    "128": "icons/favicon-128x128.png"
  },
  "permissions": [
    "storage",
    "geolocation",
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "*"
      ],
      "matches": [
        "*://*/*"
      ]
    }
  ],
  "action": {
    "_default_popup": "www/index.html",
    "default_title": "GPS Faker v2"
  },
  "side_panel": {
    "default_path": "www/index.html"
  },
  "options_ui": {
    "page": "www/index.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "css": [
        "assets/content.css"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject-hook.js"
      ],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "description": ".",
  "version": "3.5.0"
}